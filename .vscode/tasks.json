{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Home Assistant",
      "type": "shell",
      "command": "scripts/develop.sh",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Run Simulator",
      "type": "shell",
      "command": "scripts/run_sim.sh",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "uv run pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format --check . && uv run mypy",
      "problemMatcher": []
    }
  ]
}
